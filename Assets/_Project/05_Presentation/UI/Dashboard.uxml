<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Dashboard.uss" />
    <ui:VisualElement name="dashboard-root" class="dashboard-root">

        <!--
        Hero strip — 5 Hero KPI cards in the order locked by
        DECISIONS.md #39 (pyramide cause → effet):
            Haies → Nappe → Biodiversité → Rentabilité → Delta tech

        Honesty status:
        - Haies and Nappe are wired to real model variables and update each tick.
        - Biodiversité, Rentabilité, Delta tech are placeholders until their
          state variables exist (cf DECISIONS.md #40). They render the card
          shell with an em dash and an italic deferral label.
        -->
        <!--
        Speed bar (sub-étape 7c.3) — overlaid centre-top of the hero strip.
        Four buttons (pause / x1 / x10 / skip-to-end) plus a day counter.
        Wired by SpeedControlsBinding on the same UIDocument GameObject.
        The last selected play-speed (x1 or x10) is persisted in PlayerPrefs.
        Skip-to-end advances by exactly ScenarioContext.HorizonInDays
        and leaves the runner paused.
        -->
        <ui:VisualElement name="speed-bar" class="speed-bar">
            <ui:Button name="speed-pause-button" text="⏸" tooltip="Pause" class="speed-button" />
            <ui:Button name="speed-x1-button" text="▶ ×1" tooltip="Lecture vitesse réelle (1 jour simulé / seconde)" class="speed-button" />
            <ui:Button name="speed-x5-button" text="▶ ×5" tooltip="Accélération modérée (5 jours simulés / seconde)" class="speed-button" />
            <ui:Button name="speed-x10-button" text="▶▶ ×10" tooltip="Accélération forte (10 jours simulés / seconde)" class="speed-button" />
            <ui:Button name="speed-x20-button" text="▶▶ ×20" tooltip="Fast-scan (20 jours simulés / seconde — utile pour traverser plusieurs années sans skip-to-end)" class="speed-button" />
            <ui:Button name="speed-skip-end-button" text="⏭ Horizon" tooltip="Avance la simulation de HorizonInDays jours, puis met en pause." class="speed-button" />
            <ui:Label name="speed-day-counter" text="Jour 0" class="speed-day-counter" />
        </ui:VisualElement>

        <ui:VisualElement name="hero-strip" class="hero-strip">

            <ui:VisualElement name="kpi-hedgerow-density" class="kpi-card" tooltip="Densité linéaire de haies par hectare. Source : variable d'état du modèle, lecture directe.">
                <ui:Label name="hedgerow-density-label" text="Densité de haies" class="kpi-label" />
                <ui:VisualElement class="kpi-value-row">
                    <ui:Label name="hedgerow-density-value" text="—" class="kpi-value" />
                    <ui:Label name="hedgerow-density-unit" text="m/ha" class="kpi-unit" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="kpi-water-table" class="kpi-card" tooltip="Profondeur du toit de la nappe phréatique sous la surface. Source : variable d'état du modèle, lecture directe. Convention : valeur faible = nappe haute = sain. Valeur élevée = sécheresse.">
                <ui:Label name="water-table-label" text="Nappe (profondeur)" class="kpi-label" />
                <ui:VisualElement class="kpi-value-row">
                    <ui:Label name="water-table-value" text="—" class="kpi-value" />
                    <ui:Label name="water-table-unit" text="m sous sol" class="kpi-unit" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="kpi-biodiversity" class="kpi-card" tooltip="Score composite de biodiversité (en %). Moyenne pondérée 50 % fauna abondance + 30 % densité haies + 20 % nappe (inversée). 100 % = état de référence Perche, 0 % = effondrement.">
                <ui:Label name="biodiversity-label" text="Biodiversité" class="kpi-label" />
                <ui:VisualElement class="kpi-value-row">
                    <ui:Label name="biodiversity-value" text="—" class="kpi-value" />
                    <ui:Label name="biodiversity-unit" text="%" class="kpi-unit" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="kpi-profitability" class="kpi-card" tooltip="Rentabilité intégrée en euros par hectare et par an. Composite honnête : revenu cultures (CropYield × prix) − coûts intrants − coûts entretien + paiement pour services environnementaux haies. Toutes les variables sont des champs d'état d'EcosystemModel.">
                <ui:Label name="profitability-label" text="Rentabilité intégrée" class="kpi-label" />
                <ui:VisualElement class="kpi-value-row">
                    <ui:Label name="profitability-value" text="—" class="kpi-value" />
                    <ui:Label name="profitability-unit" text="€/ha/an" class="kpi-unit" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="kpi-tech-delta" class="kpi-card" tooltip="Avantage relatif (en %) de la run réelle sur la run fantôme, sur la rentabilité intégrée. Le DT fait tourner en parallèle une seconde simulation à laquelle aucune décision tech n'est appliquée — la différence chiffre l'apport net des arbitrages de l'agriculteur.">
                <ui:Label name="tech-delta-label" text="Delta tech" class="kpi-label" />
                <ui:VisualElement class="kpi-value-row">
                    <ui:Label name="tech-delta-value" text="—" class="kpi-value" />
                    <ui:Label name="tech-delta-unit" text="%" class="kpi-unit" />
                </ui:VisualElement>
                <!--
                Permanent caption: makes the shadow-run mechanic legible
                without requiring the visitor to hover the tooltip
                (sub-étape 10a friction #1). Stays present even when the
                value is at 0 (no decisions yet) so the framing reads
                even on a fresh run.
                -->
                <ui:Label name="tech-delta-caption" text="Réel vs run fantôme (sans décisions)" class="kpi-caption" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!--
        Scenario panel (left side) — 6 physical inputs + horizon,
        organised in three sections: Climat, Agriculture, Politique.
        Replaces the abstract [0,1] sliders from the first iteration of
        7c.1. Each input has a real unit (°C, %, m/ha/an, €/m/an, etc.)
        and is bound to a ScenarioContext field by ScenarioControlsBinding.
        Continuous params transition over 10 simulated days
        (CLAUDE.md §15); horizon is applied directly (it's a deadline,
        not a smoothed setpoint).
        -->
        <!--
        Scenario panel — LEFT side. Holds everything that is EXOGENOUS to
        the farmer: climate (subi), public policy framework (MAEC, PSE
        rates set by the EU/State), and the deployed sensors (passive
        observations of the world). Restructured 2026-05-21 so the
        "what is imposed" vs "what the farmer decides" boundary is
        visually unambiguous (cf. decision-panel on the right).
        -->
        <ui:VisualElement name="scenario-panel" class="scenario-panel">
            <ui:Label text="Cadre extérieur" class="scenario-panel-title" tooltip="Conditions imposées à l'exploitation : climat subi et politiques publiques en vigueur. Les capteurs (à droite, en bas) observent passivement le système." />

            <!--
            Preset row — one button per ScenarioPresetDefinition. A
            preset is a "Cadre extérieur" shortcut: climate × public
            policy combo. It NEVER touches the farmer's sliders
            (arrachage haies, intensité d'intrants) which stay under
            user control in the right-hand "Espace agriculteur".
            -->
            <ui:Label text="Préréglages de cadre" class="scenario-section-title scenario-section-title--preset" tooltip="Un clic = un cadre climatique + politique sourcé. Les sliders ci-dessous restent libres pour ajuster finement. Les décisions de l'agriculteur (à droite) ne sont JAMAIS modifiées par un preset." />
            <ui:VisualElement name="scenario-presets-row" class="scenario-presets-row" />

            <ui:Label text="Conditions naturelles (subies)" class="scenario-section-title scenario-section-title--natural" tooltip="Conditions climatiques et météorologiques imposées de l'extérieur à l'exploitation. Le scénario climatique sous-jacent (RCP4.5, RCP8.5, etc.) façonne ces deux paramètres." />

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Anomalie T° moyenne" class="scenario-control-label" />
                    <ui:Label name="temperature-anomaly-value" text="0.0 °C" class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="temperature-anomaly-slider" low-value="-2" high-value="5" value="0" class="scenario-slider" show-input-field="true" />
                <ui:Label text="−2 °C (refroidissement) à +5 °C (RCP8.5 horizon 2100). Affecte météo, nappe, rendement, intrants." class="scenario-control-hint" />
            </ui:VisualElement>

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Anomalie précipitations" class="scenario-control-label" />
                    <ui:Label name="precipitation-anomaly-value" text="0 %" class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="precipitation-anomaly-slider" low-value="-60" high-value="20" value="0" class="scenario-slider" show-input-field="true" />
                <ui:Label text="−60 % (sécheresse extrême) à +20 % (excès humidité). Référence Perche ≈ 730 mm/an." class="scenario-control-hint" />
            </ui:VisualElement>

            <ui:Label text="Politiques publiques (cadre)" class="scenario-section-title scenario-section-title--policy" tooltip="Cadre financier MAEC + PSE défini par l'État et la PAC. Les taux ne sont pas choisis par l'agriculteur ; il peut seulement s'engager ou non dans ces dispositifs." />

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Couverture MAEC" class="scenario-control-label" />
                    <ui:Label name="maec-coverage-value" text="0 %" class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="maec-coverage-slider" low-value="0" high-value="100" value="0" class="scenario-slider" show-input-field="true" />
                <ui:Label text="Part de la ferme sous contrat MAEC (% SAU). Réduit le coût d'intrants jusqu'à −30 % à 100 %." class="scenario-control-hint" />
            </ui:VisualElement>

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Taux PSE" class="scenario-control-label" />
                    <ui:Label name="pse-rate-value" text="0.00 €/m/an" class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="pse-rate-slider" low-value="0" high-value="1" value="0" class="scenario-slider" show-input-field="true" />
                <ui:Label text="Paiement pour Services Environnementaux par mètre de haie. 0.30 à 0.80 selon contrat MAEC linéaire + PNR Perche." class="scenario-control-hint" />
            </ui:VisualElement>

            <!--
            Initial conditions (sub-étape 8c.4) — state of the bocage at
            day 0. Editable only while CurrentDay == 0 (locked once the
            simulation has started). The "Réinitialiser le bocage"
            button rebuilds the EcosystemModel with the current slider
            values and resets the day counter to 0, preserving the
            scenario (climate, policies, horizon).
            -->
            <ui:Label text="Conditions initiales du bocage" class="scenario-section-title scenario-section-title--initial" tooltip="État du bocage au jour 0 du run. Modifiable uniquement avant le démarrage ; verrouillé une fois la simulation lancée. Le bouton Réinitialiser permet de repartir à zéro avec les valeurs choisies." />

            <!--
            Mois de démarrage (chantier E2 / ADR #52). Phase d'entrée du
            cycle saisonnier au jour 0. La valeur est snapshotée par la
            WeatherUpdateRule à la construction du moteur, donc un
            changement mid-run ne s'applique qu'au prochain Reset.
            -->
            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Mois de démarrage" class="scenario-control-label" />
                </ui:VisualElement>
                <ui:DropdownField name="starting-month-dropdown" class="scenario-dropdown" />
                <ui:Label name="starting-month-hint" text="Appliqué immédiatement au lancement." class="scenario-control-hint" />
            </ui:VisualElement>

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Densité de haies (t=0)" class="scenario-control-label" />
                    <ui:Label name="initial-hedgerow-density-value" text="90 m/ha" class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="initial-hedgerow-density-slider" low-value="0" high-value="200" value="90" class="scenario-slider" show-input-field="true" />
            </ui:VisualElement>

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Profondeur nappe (t=0)" class="scenario-control-label" />
                    <ui:Label name="initial-water-table-depth-value" text="2.0 m" class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="initial-water-table-depth-slider" low-value="0.5" high-value="10" value="2" class="scenario-slider" show-input-field="true" />
            </ui:VisualElement>

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Abondance faune (t=0)" class="scenario-control-label" />
                    <ui:Label name="initial-fauna-population-value" text="1.00 × réf." class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="initial-fauna-population-slider" low-value="0" high-value="1.5" value="1" class="scenario-slider" show-input-field="true" />
            </ui:VisualElement>

            <ui:Label name="initial-lock-hint" text="Ajustez puis cliquez Réinitialiser pour appliquer." class="initial-lock-hint" />
            <ui:Button name="initial-reset-button" text="Réinitialiser le bocage" tooltip="Reconstruit l'EcosystemModel avec les valeurs ci-dessus et remet le compteur de jours à 0. Préserve le scénario (climat, politiques, horizon)." class="initial-reset-button" />

        </ui:VisualElement>

        <!--
        Body — Level-B panels. Each panel is a column shell with title and
        a placeholder paragraph. At sub-étape 6b only the structure exists;
        honest sub-indicators land at Étapes 7 (économie) and 8 (faune).
        -->
        <ui:VisualElement name="body-row" class="body-row">

            <ui:VisualElement name="panel-biodiversity" class="level-b-panel">
                <ui:Label text="Biodiversité" class="panel-title" />
                <ui:Label text="Sous-indicateurs détaillés (richesse spécifique faune, indice de diversité végétale, qualité des lisières). Câblage honnête à l'Étape 8."
                          class="panel-placeholder" />
            </ui:VisualElement>

            <ui:VisualElement name="panel-climate-resources" class="level-b-panel">
                <ui:Label text="Climat &amp; ressources" class="panel-title" />
                <ui:VisualElement class="panel-row">
                    <ui:Label text="Nappe phréatique" class="panel-row-label" />
                    <ui:VisualElement class="panel-row-value-group">
                        <ui:Label name="water-table-detail-value" text="—" class="panel-row-value" />
                        <ui:Label text="m" class="panel-row-unit" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Sous-indicateurs détaillés (température moyenne, précipitations cumulées, stress hydrique). Câblage progressif aux étapes suivantes."
                          class="panel-placeholder" />
            </ui:VisualElement>

            <ui:VisualElement name="panel-economy" class="level-b-panel">
                <ui:Label text="Économie" class="panel-title" />
                <ui:Label text="Sous-indicateurs détaillés (rendement cultures, coûts d'intrants, paiements pour services environnementaux). Câblage honnête à l'Étape 7."
                          class="panel-placeholder" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!--
        Decision panel — RIGHT side. Holds everything UNDER FARMER
        CONTROL: presets quick-pick, the two free sliders the farmer
        operates daily (hedge maintenance and input intensity), the
        run horizon, and the recommendations the algorithm produces for
        the farmer to arbitrate. Restructured 2026-05-21 to co-locate
        all "agriculteur" UI (was split between scenario-panel and a
        separate decision-panel above the sensor list).
        -->
        <ui:VisualElement name="decision-panel" class="decision-panel">
            <ui:Label text="Espace agriculteur" class="decision-panel-title" tooltip="Tout ce que l'agriculteur contrôle directement : ses pratiques quotidiennes, l'horizon de simulation, l'arbitrage des recommandations." />

            <ui:Label text="Décisions quotidiennes" class="scenario-section-title scenario-section-title--decision" tooltip="Choix sous le contrôle direct de l'agriculteur : entretien du bocage, intensité des pratiques agricoles." />

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Taux d'arrachage de haies" class="scenario-control-label" />
                    <ui:Label name="hedge-removal-value" text="0.0 m/ha/an" class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="hedge-removal-slider" low-value="0" high-value="10" value="0" class="scenario-slider" show-input-field="true" />
                <ui:Label text="0 = aucune destruction. 5 = remembrement agressif (Perche 1970-90)." class="scenario-control-hint" />
            </ui:VisualElement>

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Intensité d'intrants" class="scenario-control-label" />
                    <ui:Label name="input-intensity-value" text="1.0× réf." class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="input-intensity-slider" low-value="0.5" high-value="2" value="1" class="scenario-slider" show-input-field="true" />
                <ui:Label text="0.5 = bio extensif (engrais/phytos −50 %). 1 = conventionnel. 2 = intensif." class="scenario-control-hint" />
            </ui:VisualElement>

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Couverts d'interculture" class="scenario-control-label" />
                    <ui:Label name="cover-crops-value" text="0 %" class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="cover-crops-slider" low-value="0" high-value="100" value="0" class="scenario-slider" show-input-field="true" />
                <ui:Label text="Part de la sole semée en couverts entre cultures. 0 = sol nu. 100 = couverts intégraux (Solagro Afterres 2050)." class="scenario-control-hint" />
            </ui:VisualElement>

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Restitution des résidus" class="scenario-control-label" />
                    <ui:Label name="residue-restitution-value" text="0 %" class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="residue-restitution-slider" low-value="0" high-value="100" value="0" class="scenario-slider" show-input-field="true" />
                <ui:Label text="Part des résidus de récolte laissés au sol (vs. exportés en paille/ensilage)." class="scenario-control-hint" />
            </ui:VisualElement>

            <ui:Label text="Horizon de simulation" class="scenario-section-title scenario-section-title--decision" tooltip="Durée totale du run sur laquelle l'agriculteur veut projeter sa stratégie." />

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Durée du run" class="scenario-control-label" />
                    <ui:Label name="horizon-value" text="365 j" class="scenario-control-value" />
                </ui:VisualElement>
                <ui:SliderInt name="horizon-slider" low-value="30" high-value="1825" value="365" class="scenario-slider" show-input-field="true" />
                <ui:Label text="30 j (1 mois) à 1825 j (5 ans). Utilisé par skip-to-end." class="scenario-control-hint" />
            </ui:VisualElement>

            <!--
            Manual interventions — sub-étape 10a friction fix:
            the 3 algorithm-driven actions (plant hedges, irrigation,
            reduce inputs) are now also accessible permanently as
            farmer buttons, not only when a recommendation is shown.
            Each has its own magnitude slider with the same range as
            the recommendation popup. Effects bypass the journal (no
            arbitrage history) but DO diverge real vs shadow run, so
            the TechDelta KPI captures them.
            -->
            <ui:Label text="Interventions ponctuelles" class="scenario-section-title scenario-section-title--decision" tooltip="Actions « ponctuelles » que l'agriculteur peut déclencher à tout moment, indépendamment des recommandations algorithmiques. Effet immédiat sur le modèle." />

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Replanter des haies" class="scenario-control-label" />
                    <ui:Label name="manual-plant-hedges-value" text="30 m/ha" class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="manual-plant-hedges-slider" low-value="0" high-value="50" value="30" class="scenario-slider" show-input-field="true" />
                <ui:Button name="manual-plant-hedges-button" text="Planter" class="manual-action-button" tooltip="Ajoute la magnitude choisie (m/ha) à la densité courante des haies. Coût d'investissement non modélisé en v1 (cf BACKLOG.md #9)." />
            </ui:VisualElement>

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Irriguer / soulager la nappe" class="scenario-control-label" />
                    <ui:Label name="manual-irrigation-value" text="0.5 m" class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="manual-irrigation-slider" low-value="0" high-value="3" value="0.5" class="scenario-slider" show-input-field="true" />
                <ui:Button name="manual-irrigation-button" text="Irriguer" class="manual-action-button" tooltip="Remonte le toit de la nappe de la profondeur choisie (m). Floor à 0.5 m pour éviter l'engorgement." />
            </ui:VisualElement>

            <ui:VisualElement class="scenario-control">
                <ui:VisualElement class="scenario-control-header">
                    <ui:Label text="Baisser intrants (pulse)" class="scenario-control-label" />
                    <ui:Label name="manual-reduce-inputs-value" text="0.20× réf." class="scenario-control-value" />
                </ui:VisualElement>
                <ui:Slider name="manual-reduce-inputs-slider" low-value="0" high-value="0.5" value="0.2" class="scenario-slider" show-input-field="true" />
                <ui:Button name="manual-reduce-inputs-button" text="Appliquer" class="manual-action-button" tooltip="Pulse de réduction d'intrants : boost faune ponctuel + baisse instantanée des coûts. Pour une réduction continue, utilise plutôt le slider Intensité d'intrants ci-dessus." />
            </ui:VisualElement>

            <ui:Label text="Recommandations algorithmiques" class="scenario-section-title scenario-section-title--decision" tooltip="Les recos produites par l'algorithme apparaissent comme un popup centré qui met la simulation en pause. Le bouton ci-dessous ouvre la liste des recommandations en attente (dont celles que tu as différées via Voir plus tard)." />
            <ui:Button name="decision-history-open-button" text="Aucune recommandation en cours" class="decision-history-open-button" tooltip="Ouvre la liste des recommandations actuellement en attente. Click sur une ligne = ré-ouvre la popup de recommandation pour l'examiner." />

        </ui:VisualElement>

        <!--
        Sensor list — floating bottom-right panel listing the deployed
        sensors with status (online / deferred). Rows spawned by
        SensorListBinding from each SensorMetadataTag in the scene.
        Kept as a separate floating element rather than inlined in
        the scenario-panel: sensors are a passive readout of the world,
        independent from the climate/policy framework.
        -->
        <ui:VisualElement name="sensor-list-container" class="sensor-list-container">
            <ui:Label text="Capteurs déployés" class="sensor-list-title" />
            <ui:VisualElement name="sensor-list-rows" class="sensor-list-rows" />
            <ui:VisualElement class="sensor-list-legend">
                <ui:VisualElement class="sensor-list-legend-row">
                    <ui:VisualElement class="sensor-status-dot sensor-status-dot--online" />
                    <ui:Label text="branché" class="sensor-list-legend-text" />
                </ui:VisualElement>
                <ui:VisualElement class="sensor-list-legend-row">
                    <ui:VisualElement class="sensor-status-dot sensor-status-dot--deferred" />
                    <ui:Label text="en attente" class="sensor-list-legend-text" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!--
        Decision popup overlay (sub-étape 8c.3 post-livraison iteration).
        Modal centred popup that opens when the DecisionJournal has at
        least one pending entry. Pauses the simulation while visible,
        resumes at the previous speed once the queue is empty. Spawned
        at the END of dashboard-root so it stacks above every other
        element (UI Toolkit's z-order is DOM order within parent).
        -->
        <ui:VisualElement name="decision-popup-overlay" class="decision-popup-overlay hidden">
            <ui:VisualElement name="decision-popup-card" class="decision-popup-card">
                <ui:Label name="decision-popup-title" text="Recommandation" class="decision-popup-title" />
                <!--
                Source-event line: makes the « capteur → événement →
                recommandation » causal chain visible without doc
                (sub-étape 10a friction #2). Populated at runtime by
                DecisionPopupBinding via RecommendationProvenance.Format.
                Empty string by default so the line collapses cleanly
                when no recommendation is shown.
                -->
                <ui:Label name="decision-popup-source-event" text="" class="decision-popup-source-event" />
                <ui:Label name="decision-popup-rationale" text="..." class="decision-popup-rationale" />

                <ui:VisualElement name="decision-popup-outcomes" class="decision-popup-outcomes" />

                <ui:Label text="Choisir l'ampleur de l'action :" class="decision-popup-prompt" />
                <ui:VisualElement class="decision-popup-magnitude-row">
                    <ui:Label name="decision-popup-magnitude-label" text="Magnitude" class="decision-popup-magnitude-label" />
                    <ui:Label name="decision-popup-magnitude-value" text="—" class="decision-popup-magnitude-value" />
                </ui:VisualElement>
                <ui:Slider name="decision-popup-magnitude-slider" low-value="0" high-value="1" value="0" class="decision-popup-magnitude-slider" show-input-field="true" />

                <ui:VisualElement class="decision-popup-actions">
                    <ui:Button name="decision-popup-ignore-button" text="Ignorer" class="decision-popup-button decision-popup-button--ignore" tooltip="Rejette définitivement cette recommandation. Aucune action mécanique. La simulation reprend." />
                    <ui:Button name="decision-popup-defer-button" text="Voir plus tard" class="decision-popup-button decision-popup-button--defer" tooltip="Garde la recommandation en attente sans décider maintenant. Retrouvable via le bouton 'Recommandations en cours'. La simulation reprend." />
                    <ui:Button name="decision-popup-validate-button" text="Valider" class="decision-popup-button decision-popup-button--validate" tooltip="Applique l'action avec la magnitude choisie. La simulation reprend." />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!--
        History list overlay — centred modal popup that lists every
        pending recommendation. Spawned by DecisionPanelBinding when
        the user clicks "Recommandations en cours". Rows are built
        dynamically by DecisionPanelBinding.BuildHistoryRow; each row
        has a title + day issued + "Examiner" button that re-opens
        the single-rec popup for that recommendation.
        -->
        <ui:VisualElement name="decision-history-overlay" class="decision-history-overlay hidden">
            <ui:VisualElement class="decision-history-card">
                <ui:Label text="Recommandations en attente" class="decision-history-title" />
                <ui:Label text="L'algorithme a détecté ces événements. Sélectionne-en un pour examiner la recommandation et choisir une action." class="decision-history-help" />
                <ui:VisualElement name="decision-history-list" class="decision-history-list" />
                <ui:Label name="decision-history-empty" text="Aucune recommandation en attente pour le moment." class="decision-history-empty" />
                <ui:VisualElement class="decision-history-footer">
                    <ui:Button name="decision-history-close-button" text="Fermer" class="decision-history-close-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!--
        Viewport warning banner — hidden by default, made visible by
        ViewportWarningBinding when Screen.width is below the recommended
        threshold (1280 px per CLAUDE.md §12, desktop only).
        -->
        <ui:VisualElement name="viewport-warning" class="viewport-warning hidden">
            <ui:Label text="Cette expérience est optimisée pour un affichage de 1280 pixels de large ou plus. Agrandissez la fenêtre pour une meilleure lecture du tableau de bord."
                      class="viewport-warning-text" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
