/*
 * Dashboard stylesheet — sub-étape 6b.
 *
 * Dark mode palette per CLAUDE.md §11:
 *   bg general : gris-anthracite chaud
 *   text       : crème / ivoire
 *   accents    : désaturés (vert bouteille, ocre, rouge terre)
 *
 * Layout philosophy (cf DECISIONS.md #6 viewport architecture):
 *   - The scene render lives in a centred Camera.rect viewport.
 *   - The UI overlay reserves four UI margins (top, bottom, left, right)
 *     plus a bottom-right minimap. The dashboard root therefore uses
 *     absolute positioning to anchor its panels to the four edges,
 *     leaving the scene visible in the central window.
 *
 * Fonts (Garamond + JetBrains Mono per CLAUDE.md §11): not yet imported
 * as Unity Font Definition assets. When that lands (small dedicated
 * step), we'll add `-unity-font-definition: url(...)` to .panel-title,
 * .kpi-label, .kpi-value, etc. without touching the structure.
 */

/* =========================================================================
 *  Root layout
 * ========================================================================= */

.dashboard-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0); /* transparent — scene shows through */
}

/* =========================================================================
 *  Hero strip — 5 KPI cards anchored top
 * ========================================================================= */

.hero-strip {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: flex-start;
    padding: 12px 16px 12px 16px;
    background-color: rgba(20, 22, 26, 0.92);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.kpi-card {
    flex-direction: column;
    min-width: 200px;
    padding: 8px 14px 10px 14px;
    margin-right: 10px;
    background-color: rgba(28, 31, 36, 0.94);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
}

/*
 * Deferred KPI cards (Biodiversité, Rentabilité, Delta tech at 6b).
 * Slightly muted background and dashed border so the user instantly
 * recognises a non-honest card vs an honest one — same "à venir"
 * literacy pattern used in the Niveau B panels.
 */
.kpi-card--deferred {
    background-color: rgba(28, 31, 36, 0.70);
    border-color: rgba(170, 162, 145, 0.22);
}

.kpi-label {
    font-size: 12px;
    color: rgba(220, 214, 198, 0.75);    /* crème désaturée */
    -unity-font-style: italic;
    margin-bottom: 4px;
}

.kpi-value-row {
    flex-direction: row;
    align-items: flex-end;
}

.kpi-value {
    font-size: 26px;
    color: rgba(238, 232, 217, 1);       /* ivoire */
    -unity-font-style: bold;
    margin-right: 6px;
}

/* Em dash + reduced contrast for deferred KPIs. */
.kpi-value--deferred {
    color: rgba(170, 162, 145, 0.55);
}

.kpi-unit {
    font-size: 12px;
    color: rgba(170, 162, 145, 0.85);    /* ocre désaturé */
    padding-bottom: 4px;                  /* aligne sur la baseline du chiffre */
}

/*
 * Small italic chip below the em dash on a deferred card, telling the
 * reader *when* the KPI becomes honest.
 */
.kpi-deferred-tag {
    font-size: 10px;
    color: rgba(170, 162, 145, 0.65);
    -unity-font-style: italic;
    margin-top: 2px;
}

/* =========================================================================
 *  Body row — Level-B panels
 * ========================================================================= */

/*
 * Anchored bottom-left, leaving the bottom-right corner for the minimap.
 * Three columns side-by-side, equal width via flex-grow.
 */
.body-row {
    position: absolute;
    bottom: 12px;
    left: 290px;                           /* scenario-panel reserves the left gutter */
    right: 280px;                          /* sensor list reserves the right gutter */
    flex-direction: row;
    align-items: stretch;
}

/* =========================================================================
 *  Scenario panel — sub-étape 7c.1 (left side, full vertical span)
 * ========================================================================= */

.scenario-panel {
    position: absolute;
    top: 130px;                           /* clears the full hero-strip height */
    bottom: 16px;
    left: 16px;
    width: 260px;
    padding: 10px 14px 12px 14px;
    background-color: rgba(28, 31, 36, 0.94);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    flex-direction: column;
    justify-content: flex-start;
}

.scenario-panel-title {
    font-size: 14px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.scenario-section-title {
    font-size: 10px;
    color: rgba(170, 162, 145, 0.85);
    -unity-font-style: italic;
    margin-top: 4px;
    margin-bottom: 4px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
}

.scenario-control {
    flex-direction: column;
    margin-bottom: 10px;
}

.scenario-control-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
}

.scenario-control-label {
    font-size: 11px;
    color: rgba(220, 214, 198, 0.85);
}

.scenario-control-unit {
    font-size: 10px;
    color: rgba(170, 162, 145, 0.85);
    -unity-font-style: italic;
}

/*
 * .scenario-slider — Slider or SliderInt with the dark theme.
 * UI Toolkit's default slider has a beige editor chrome; we override
 * the standard DOM classes (.unity-base-slider*) to match the panel.
 * Hide the auto-generated label (we have our own header row).
 */
.scenario-slider {
    margin-top: 2px;
    margin-bottom: 2px;
    min-height: 18px;
}

/* Hide the auto inline label of the slider. */
.scenario-slider > .unity-base-field__label,
.scenario-slider > .unity-base-slider__label {
    display: none;
    min-width: 0;
    width: 0;
}

/* The track behind the slider. */
.scenario-slider .unity-base-slider__tracker {
    background-color: rgba(16, 18, 22, 1);
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.20);
    border-radius: 3px;
}

/* The filled portion of the slider track (between low-value and current). */
.scenario-slider .unity-base-slider__dragger-border {
    border-color: rgba(0, 0, 0, 0);
}

/* The draggable thumb. */
.scenario-slider .unity-base-slider__dragger {
    background-color: rgba(124, 168, 100, 1); /* vert pâle d'accent */
    border-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-radius: 4px;
    width: 12px;
    height: 12px;
}

.scenario-slider:hover .unity-base-slider__dragger {
    background-color: rgba(150, 190, 124, 1);
}

.scenario-control-hint {
    font-size: 9px;
    color: rgba(170, 162, 145, 0.55);
    -unity-font-style: italic;
    white-space: normal;
}

.level-b-panel {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 10px;
    padding: 10px 14px 12px 14px;
    background-color: rgba(28, 31, 36, 0.94);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
}

.panel-title {
    font-size: 14px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.panel-placeholder {
    font-size: 11px;
    color: rgba(170, 162, 145, 0.55);
    -unity-font-style: italic;
    white-space: normal;                   /* allow wrap */
}

/* Honest sub-indicator row inside a Level-B panel. */
.panel-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 8px;
}

.panel-row-label {
    font-size: 12px;
    color: rgba(220, 214, 198, 0.80);
}

.panel-row-value-group {
    flex-direction: row;
    align-items: flex-end;   /* UI Toolkit USS does not support 'baseline'; flex-end aligns the unit suffix on the digit baseline closely enough. */
}

.panel-row-value {
    font-size: 16px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
    margin-right: 4px;
}

.panel-row-unit {
    font-size: 10px;
    color: rgba(170, 162, 145, 0.80);
}

/* =========================================================================
 *  Minimap — placeholder rectangle bottom-right (6c will fill it)
 * ========================================================================= */

/* =========================================================================
 *  Sensor list — replaces the minimap (sub-étape 6c.2 decision)
 * ========================================================================= */

.sensor-list-container {
    position: absolute;
    bottom: 12px;
    right: 16px;
    width: 256px;
    padding: 10px 12px 10px 12px;
    background-color: rgba(28, 31, 36, 0.94);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    flex-direction: column;
    justify-content: flex-start;
}

.sensor-list-title {
    font-size: 12px;
    color: rgba(220, 214, 198, 0.75);
    -unity-font-style: italic;
    margin-bottom: 6px;
}

.sensor-list-rows {
    flex-direction: column;
}

/*
 * One row per sensor. Created at runtime by SensorListBinding from the
 * scene's SensorMetadataTag components. The .sensor-row-status-dot
 * (online/deferred) sits at the left, with a two-line text block at
 * the right.
 */
.sensor-list-row {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.03);
    border-radius: 3px;
}

/*
 * Highlighted state — toggled via class by SensorListBinding either
 * when the row receives a PointerEnter or when the scene-side
 * SensorHoverEmitter raises an Enter for the matching sensor id.
 * Provides the UI feedback of the bidirectional hover sync (6c.3).
 */
.sensor-list-row--highlighted {
    background-color: rgba(124, 168, 100, 0.12); /* vert pâle très transparent */
}

.sensor-status-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-top: 3px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.55);
    flex-shrink: 0;
}

.sensor-status-dot--online {
    background-color: rgba(124, 168, 100, 1);    /* vert pâle, branché */
}

.sensor-status-dot--deferred {
    background-color: rgba(170, 162, 145, 0.55);  /* ocre désaturé, en attente */
}

.sensor-row-text {
    flex-direction: column;
    flex-grow: 1;
}

.sensor-row-name {
    font-size: 12px;
    color: rgba(238, 232, 217, 1);                /* ivoire */
}

.sensor-row-subtitle {
    font-size: 10px;
    color: rgba(170, 162, 145, 0.75);             /* ocre désaturé */
    -unity-font-style: italic;
    white-space: normal;
}

.sensor-list-legend {
    margin-top: 8px;
    flex-direction: column;
}

.sensor-list-legend-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.sensor-list-legend .sensor-status-dot {
    margin-top: 0;
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

.sensor-list-legend-text {
    font-size: 10px;
    color: rgba(220, 214, 198, 0.70);
    -unity-font-style: italic;
}

/* =========================================================================
 *  Viewport warning banner — appears under 1280 px width
 * ========================================================================= */

.viewport-warning {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 8px 16px 8px 16px;
    background-color: rgba(112, 56, 38, 0.92);  /* terre brûlée désaturée */
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.viewport-warning-text {
    font-size: 12px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: italic;
    white-space: normal;
}

/* Utility class toggled by ViewportWarningBinding. */
.hidden {
    display: none;
}
