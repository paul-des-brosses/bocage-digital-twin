/*
 * Dashboard stylesheet — sub-étape 6b.
 *
 * Dark mode palette per CLAUDE.md §11:
 *   bg general : gris-anthracite chaud
 *   text       : crème / ivoire
 *   accents    : désaturés (vert bouteille, ocre, rouge terre)
 *
 * Layout philosophy (cf DECISIONS.md #6 viewport architecture):
 *   - The scene render lives in a centred Camera.rect viewport.
 *   - The UI overlay reserves four UI margins (top, bottom, left, right)
 *     plus a bottom-right minimap. The dashboard root therefore uses
 *     absolute positioning to anchor its panels to the four edges,
 *     leaving the scene visible in the central window.
 *
 * Fonts (Garamond + JetBrains Mono per CLAUDE.md §11): not yet imported
 * as Unity Font Definition assets. When that lands (small dedicated
 * step), we'll add `-unity-font-definition: url(...)` to .panel-title,
 * .kpi-label, .kpi-value, etc. without touching the structure.
 */

/* =========================================================================
 *  Root layout
 * ========================================================================= */

.dashboard-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0); /* transparent — scene shows through */
}

/* =========================================================================
 *  Flex frame containers (refacto E7.3, 2026-06-02) — replaces the previous
 *  absolute-pixel tiling. main-band fills the height below the hero strip;
 *  three columns sit inside it: left scenario panel / centre scene spacer /
 *  right farmer+sensors column.
 * ========================================================================= */

.main-band {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    min-height: 0;                          /* lets the panels' ScrollViews bound their height instead of growing */
}

.center-column {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-end;              /* Niveau B triggers pinned to the bottom; scene shows through above */
}

.right-column {
    width: 264px;
    flex-shrink: 0;
    min-height: 0;                          /* bounded by main-band so the decision panel + sensor footer fit the band height */
    flex-direction: column;
    margin: 12px 16px 16px 0;
}

/* Scrollable content region inside the left/right panels — controls keep
   their natural height and scroll rather than crush (the old absolute
   layout shrank rows until the slider dragger overlapped its own label). */
.panel-scroll {
    flex-grow: 1;
    min-height: 0;
}

/* ScrollView dark theming: thin desaturated thumb, no arrow buttons, no
   horizontal bar. */
.panel-scroll .unity-scroller--vertical {
    width: 9px;
    background-color: rgba(0, 0, 0, 0);
}
.panel-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.panel-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(170, 162, 145, 0.28);
    border-width: 0;
    border-radius: 4px;
    width: 6px;
}
.panel-scroll .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(170, 162, 145, 0.50);
}
.panel-scroll .unity-scroller__low-button,
.panel-scroll .unity-scroller__high-button {
    display: none;
}
.panel-scroll .unity-scroller--horizontal {
    display: none;
}

/* =========================================================================
 *  Speed bar (sub-étape 7c.3) — top-centre, above the hero strip
 * ========================================================================= */

/*
 * Anchored top-centre, positioned at z above the hero strip via a small
 * negative top + transparent background. Four buttons in a row + a day
 * counter label. Active play-speed gets the green accent border via
 * .speed-button--active (mirrors .scenario-preset-button--active).
 */
/* Fixed-height top band wrapping the speed bar + hero strip. Height = the
   scene's TOP margin in px at 1920×1080: (1 − rect.top) × 1080 = 158. The
   camera viewportRect is left untouched, so this band and the scene derive
   from the same number — the hero can never overlap the scene. */
.top-band {
    flex-shrink: 0;
    height: 158px;
}

.speed-bar {
    align-self: center;                     /* centred horizontally in the column root */
    flex-shrink: 0;
    margin-top: 6px;
    margin-bottom: 2px;
    flex-direction: row;
    align-items: center;
    padding: 4px 8px 4px 8px;
    background-color: rgba(20, 22, 26, 0.85);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.speed-button {
    margin: 0 2px 0 2px;
    padding: 2px 8px 2px 8px;
    min-height: 22px;
    background-color: rgba(16, 18, 22, 1);
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.20);
    border-radius: 3px;
    color: rgba(220, 214, 198, 0.85);
    font-size: 11px;
}

.speed-button:hover {
    background-color: rgba(28, 31, 36, 1);
    border-color: rgba(170, 162, 145, 0.45);
    color: rgba(238, 232, 217, 1);
}

.speed-button--active {
    border-color: rgba(124, 168, 100, 0.85);
    background-color: rgba(28, 38, 28, 0.85);
    color: rgba(238, 232, 217, 1);
}

.speed-day-counter {
    margin-left: 10px;
    font-size: 11px;
    color: rgba(170, 162, 145, 0.85);
    -unity-font-style: italic;
}

/* =========================================================================
 *  Hero strip — 5 KPI cards anchored top
 * ========================================================================= */

.hero-strip {
    flex-shrink: 0;                       /* fixed-height top band; never compresses */
    flex-direction: row;
    justify-content: center;              /* 5 KPI cards centred as a tight group */
    padding: 12px 16px 12px 16px;
    background-color: rgba(20, 22, 26, 0.92);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.kpi-card {
    flex-direction: column;
    min-width: 200px;
    padding: 8px 14px 10px 14px;
    margin-right: 10px;
    background-color: rgba(28, 31, 36, 0.94);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
}

.kpi-label {
    font-size: 12px;
    color: rgba(220, 214, 198, 0.75);    /* crème désaturée */
    -unity-font-style: italic;
    margin-bottom: 4px;
}

.kpi-value-row {
    flex-direction: row;
    align-items: flex-end;
}

.kpi-value {
    font-size: 26px;
    color: rgba(238, 232, 217, 1);       /* ivoire */
    -unity-font-style: bold;
    margin-right: 6px;
}

.kpi-unit {
    font-size: 12px;
    color: rgba(170, 162, 145, 0.85);    /* ocre désaturé */
    padding-bottom: 4px;                  /* aligne sur la baseline du chiffre */
}

/*
 * Permanent inline caption appended to a Hero KPI card to clarify its
 * meaning at a glance (used by tech-delta to surface the shadow-run
 * mechanic without requiring a tooltip hover). Sub-étape 10a friction
 * #1 fix. A small italic chip that ANCHORS reading, not a placeholder.
 */
.kpi-caption {
    font-size: 10px;
    color: rgba(220, 214, 198, 0.55);
    -unity-font-style: italic;
    margin-top: 2px;
    white-space: normal;
}

/* =========================================================================
 *  Body row — Level-B panels
 * ========================================================================= */

/*
 * Anchored bottom-left, leaving the bottom-right corner for the minimap.
 * Three columns side-by-side, equal width via flex-grow.
 */
/* Bottom strip — Niveau B tab group + sensor list side by side, pinned to
   the bottom of the centre column. Sensors moved here out of the right
   column so the decision panel gets the full height (no scroll). */
.bottom-strip {
    flex-shrink: 0;
    flex-direction: row;
    align-items: stretch;
    height: 162px;                          /* scene's BOTTOM margin at 1920×1080: rect.y × 1080 = 162 — matches the camera rect */
    margin: 0 8px 0 8px;
}

.body-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: stretch;
    margin-right: 10px;
}

/* Empty placeholder panel filling the bottom strip to the right of the
   sensor list — reserved for future content (kept on purpose, ADR-free). */
.bottom-placeholder {
    flex-grow: 1;
    min-width: 80px;
    margin-left: 10px;
    background-color: rgba(28, 31, 36, 0.55);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
}

/* =========================================================================
 *  Scenario panel — sub-étape 7c.1 (left side, full vertical span)
 * ========================================================================= */

.scenario-panel {
    width: 264px;
    flex-shrink: 0;
    min-height: 0;                        /* bounded by main-band so the inner ScrollView scrolls instead of overflowing */
    margin: 12px 0 16px 16px;
    padding: 10px 14px 12px 14px;
    background-color: rgba(28, 31, 36, 0.94);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    flex-direction: column;
    justify-content: flex-start;
}

.scenario-panel-title {
    font-size: 14px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.scenario-section-title {
    font-size: 10px;
    color: rgba(170, 162, 145, 0.85);
    -unity-font-style: italic;
    margin-top: 3px;
    margin-bottom: 2px;
    padding-top: 2px;
    padding-left: 6px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
    border-left-width: 3px;
    border-left-color: rgba(170, 162, 145, 0.40);     /* default: ocre désaturé */
}

/*
 * Section title modifiers (sub-étape 8c.3 polish). Each section gets a
 * distinct left-border accent so the user can tell at a glance which
 * sliders below are exogenous (climate, weather) vs. under farmer
 * control vs. set by public policy. The palette uses the desaturated
 * earth / vegetal accents of CLAUDE.md §11.
 */
.scenario-section-title--natural {
    border-left-color: rgba(170, 100, 60, 0.85);      /* terre brûlée — climat subi */
    color: rgba(200, 160, 130, 0.95);
}

.scenario-section-title--decision {
    border-left-color: rgba(110, 150, 100, 0.85);     /* vert bouteille — choix de l'agriculteur */
    color: rgba(180, 210, 170, 0.95);
}

.scenario-section-title--policy {
    border-left-color: rgba(150, 130, 90, 0.85);      /* ocre soutenu — cadre PAC */
    color: rgba(210, 190, 150, 0.95);
}

.scenario-section-title--preset {
    border-left-color: rgba(124, 168, 100, 0.85);     /* vert pâle — raccourcis cadre */
    color: rgba(220, 240, 200, 0.95);
}

.scenario-section-title--initial {
    border-left-color: rgba(100, 130, 170, 0.85);     /* bleu acier — état initial du bocage */
    color: rgba(170, 200, 230, 0.95);
}

/*
 * Conditions initiales — slider locked state. When CurrentDay > 0
 * the InitialConditionsBinding adds the --locked modifier class
 * which fades the slider visuals to communicate the freeze.
 */
.initial-slider--locked .unity-base-slider__dragger {
    background-color: rgba(124, 168, 100, 0.30);
}

.initial-slider--locked .unity-base-slider__tracker {
    border-color: rgba(170, 162, 145, 0.10);
}

.initial-lock-hint {
    font-size: 9px;
    color: rgba(170, 162, 145, 0.85);
    -unity-font-style: italic;
    white-space: normal;
    margin-top: 4px;
    margin-bottom: 6px;
}

.initial-reset-button {
    margin-top: 4px;
    padding: 4px 10px 4px 10px;
    min-height: 24px;
    background-color: rgba(28, 38, 28, 0.85);
    border-width: 1px;
    border-color: rgba(124, 168, 100, 0.85);
    border-radius: 3px;
    color: rgba(238, 232, 217, 1);
    font-size: 11px;
}

.initial-reset-button:hover {
    background-color: rgba(48, 64, 48, 1);
}

/*
 * Preset row (sub-étape 7c.2) — wraps onto multiple lines when the
 * scenario-panel is narrow. Buttons are styled to match the dark dashboard
 * palette; the active preset wears the accent green border.
 */
.scenario-presets-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.scenario-preset-button {
    flex-grow: 1;
    flex-basis: 45%;
    margin: 2px;
    padding: 4px 6px 4px 6px;
    background-color: rgba(16, 18, 22, 1);
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.20);
    border-radius: 3px;
    color: rgba(220, 214, 198, 0.85);
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.scenario-preset-button:hover {
    background-color: rgba(28, 31, 36, 1);
    border-color: rgba(170, 162, 145, 0.45);
    color: rgba(238, 232, 217, 1);
}

.scenario-preset-button--active {
    border-color: rgba(124, 168, 100, 0.85);
    color: rgba(238, 232, 217, 1);
    background-color: rgba(28, 38, 28, 0.85);
}

.scenario-control {
    flex-direction: column;
    margin-bottom: 6px;
}

.scenario-control-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
}

.scenario-control-label {
    font-size: 11px;
    color: rgba(220, 214, 198, 0.85);
}

.scenario-control-unit {
    font-size: 10px;
    color: rgba(170, 162, 145, 0.85);
    -unity-font-style: italic;
}

/*
 * .scenario-slider — Slider or SliderInt with the dark theme.
 * UI Toolkit's default slider has a beige editor chrome; we override
 * the standard DOM classes (.unity-base-slider*) to match the panel.
 * Hide the auto-generated label (we have our own header row).
 */
.scenario-slider {
    margin-top: 1px;
    margin-bottom: 1px;
    min-height: 16px;
}

/* Hide the auto inline label of the slider. */
.scenario-slider > .unity-base-field__label,
.scenario-slider > .unity-base-slider__label {
    display: none;
    min-width: 0;
    width: 0;
}

/* The track behind the slider. */
.scenario-slider .unity-base-slider__tracker {
    background-color: rgba(16, 18, 22, 1);
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.20);
    border-radius: 3px;
}

/* The filled portion of the slider track (between low-value and current). */
.scenario-slider .unity-base-slider__dragger-border {
    border-color: rgba(0, 0, 0, 0);
}

/* The draggable thumb. */
.scenario-slider .unity-base-slider__dragger {
    background-color: rgba(124, 168, 100, 1); /* vert pâle d'accent */
    border-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-radius: 4px;
    width: 12px;
    height: 12px;
}

.scenario-slider:hover .unity-base-slider__dragger {
    background-color: rgba(150, 190, 124, 1);
}

/*
 * Numeric input field on the right of each slider (show-input-field=true).
 * Added 2026-05-21 to give users precise typed input on top of the drag
 * gesture (e.g. typing "+2.3" exactly instead of nudging the dragger).
 * The default chrome is beige editor-style; we restyle to match the dark
 * dashboard palette.
 */
.scenario-slider .unity-base-slider__text-field {
    min-width: 48px;
    margin-left: 6px;
    margin-right: 2px;
}

.scenario-slider .unity-base-slider__text-field .unity-base-field__input {
    background-color: rgba(16, 18, 22, 1);
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.30);
    border-radius: 3px;
    padding: 1px 4px 1px 4px;
    color: rgba(238, 232, 217, 1);
    font-size: 11px;
    -unity-text-align: middle-right;
}

.scenario-slider .unity-base-slider__text-field:hover .unity-base-field__input,
.scenario-slider .unity-base-slider__text-field:focus .unity-base-field__input {
    border-color: rgba(124, 168, 100, 0.85);
    background-color: rgba(20, 24, 22, 1);
}

/*
 * Lay the slider out horizontally so the dragger track and the text-field
 * sit side-by-side rather than the default vertical stack.
 */
.scenario-slider {
    flex-direction: row;
    align-items: center;
}

/* The track + dragger zone should fill remaining width to the left of the input field. */
.scenario-slider > .unity-base-slider__input {
    flex-grow: 1;
}

/*
 * .scenario-dropdown — start-month picker (chantier E2 / ADR #52).
 * UI Toolkit's DropdownField ships with light editor chrome AND reserves a
 * ~120px label column on the left even when no label attribute is set; both
 * clash badly with the dark panel (the empty column pushes the box off to
 * the right). The .scenario-control-header above already carries the
 * "Mois de démarrage" label, so we drop the field's own label column and
 * restyle the closed box + the open popup menu to the dashboard palette,
 * mirroring the slider text-field treatment above. Theming the popup with
 * global .unity-base-dropdown__* selectors is safe: this is the only
 * DropdownField in the whole UXML.
 */
.scenario-dropdown {
    margin-top: 2px;
    margin-bottom: 2px;
}

/* Drop the reserved (empty) label column so the field spans the full row. */
.scenario-dropdown .unity-base-field__label {
    display: none;
    min-width: 0;
    width: 0;
}

/* The closed, clickable field box. */
.scenario-dropdown .unity-base-field__input {
    background-color: rgba(16, 18, 22, 1);
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.30);
    border-radius: 3px;
    padding: 3px 8px 3px 8px;
    min-height: 24px;
}

.scenario-dropdown:hover .unity-base-field__input,
.scenario-dropdown:focus .unity-base-field__input {
    border-color: rgba(124, 168, 100, 0.85);
    background-color: rgba(20, 24, 22, 1);
}

/* The selected month text. */
.scenario-dropdown .unity-base-popup-field__text {
    color: rgba(238, 232, 217, 1);
    font-size: 11px;
    -unity-text-align: middle-left;
}

/* The drop caret on the right of the box. */
.scenario-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgba(170, 162, 145, 0.85);
}

/* ---- Open popup menu (the list shown on click) ---- */
.unity-base-dropdown__container-outer {
    background-color: rgba(20, 24, 22, 1);
    border-width: 1px;
    border-color: rgba(124, 168, 100, 0.45);
    border-radius: 3px;
}

.unity-base-dropdown__item {
    padding: 4px 8px 4px 8px;
    color: rgba(220, 214, 198, 0.90);
    font-size: 11px;
}

.unity-base-dropdown__item:hover {
    background-color: rgba(28, 38, 28, 0.85);
}

/* Accent the currently-selected month's checkmark. */
.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgba(124, 168, 100, 1);
}

.scenario-control-hint {
    font-size: 9px;
    color: rgba(170, 162, 145, 0.72);     /* contrast bumped 0.55 → 0.72 for legibility (E7.3) */
    -unity-font-style: italic;
    white-space: normal;
    margin-top: 1px;
}

.panel-title {
    font-size: 14px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

/* Honest sub-indicator row inside a Level-B panel. */
.panel-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 8px;
}

.panel-row-label {
    font-size: 12px;
    color: rgba(220, 214, 198, 0.80);
}

.panel-row-value-group {
    flex-direction: row;
    align-items: flex-end;   /* UI Toolkit USS does not support 'baseline'; flex-end aligns the unit suffix on the digit baseline closely enough. */
}

.panel-row-value {
    font-size: 16px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
    margin-right: 4px;
}

.panel-row-unit {
    font-size: 10px;
    color: rgba(170, 162, 145, 0.80);
}

/* =========================================================================
 *  Niveau B — trigger buttons + modal overlays (chantier E6 / ADR #54)
 *  Three compact buttons sit at the bottom of the viewport in .body-row;
 *  clicking one opens the matching `.level-b-modal-overlay`, which is
 *  shown/hidden via the proven `.hidden` utility class (cf
 *  decision-popup-overlay). NiveauBModalsBinding wires the clicks,
 *  click-outside dismissal, and Escape key.
 * ========================================================================= */

.level-b-trigger {
    flex-grow: 0;
    flex-basis: auto;
    width: 150px;
    white-space: normal;
    margin: 0 5px 0 5px;
    padding: 8px 14px 8px 14px;
    background-color: rgba(28, 31, 36, 0.94);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    color: rgba(238, 232, 217, 1);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-b-trigger:hover {
    background-color: rgba(48, 52, 58, 0.96);
    border-color: rgba(124, 168, 100, 0.55);
    color: rgba(238, 232, 217, 1);
}

.level-b-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    align-items: center;
    justify-content: center;
}

.level-b-modal-card {
    width: 440px;
    max-width: 85%;
    padding: 14px 20px 16px 20px;
    background-color: rgba(28, 31, 36, 0.98);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.40);
    flex-direction: column;
}

.level-b-modal-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(170, 162, 145, 0.20);
}

.level-b-modal-title {
    font-size: 16px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
}

.level-b-modal-close {
    margin: 0;
    padding: 2px 10px 2px 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgba(220, 214, 198, 0.85);
    font-size: 16px;
    -unity-font-style: bold;
}

.level-b-modal-close:hover {
    color: rgba(255, 255, 255, 1);
    background-color: rgba(0, 0, 0, 0);
}

/* =========================================================================
 *  Sensor inspection panel (chantier E6 / ADR #53)
 *  Modal popup opened by clicks on the 5 sensor sprites. Mirrors the
 *  Niveau B modal structure (full-screen overlay + centred dark card)
 *  but wider (charts need horizontal room) and with chart-specific rows.
 * ========================================================================= */

.sensor-inspector-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    align-items: center;
    justify-content: center;
}

.sensor-inspector-card {
    width: 600px;
    max-width: 90%;
    padding: 16px 22px 18px 22px;
    background-color: rgba(28, 31, 36, 0.98);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.40);
    flex-direction: column;
}

.sensor-inspector-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(170, 162, 145, 0.20);
}

.sensor-inspector-title {
    font-size: 16px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
}

.sensor-inspector-close {
    margin: 0;
    padding: 2px 10px 2px 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgba(220, 214, 198, 0.85);
    font-size: 16px;
    -unity-font-style: bold;
}

.sensor-inspector-close:hover {
    color: rgba(255, 255, 255, 1);
    background-color: rgba(0, 0, 0, 0);
}

.sensor-inspector-subtitle {
    font-size: 11px;
    color: rgba(220, 214, 198, 0.75);
    -unity-font-style: italic;
    white-space: normal;
    margin-bottom: 10px;
}

.sensor-inspector-chart-caption {
    font-size: 11px;
    color: rgba(238, 232, 217, 0.85);
    -unity-font-style: italic;
    margin-top: 6px;
    margin-bottom: 4px;
}

.sensor-inspector-chart-row {
    flex-direction: row;
    align-items: stretch;
    height: 140px;
}

.sensor-inspector-axis-column {
    flex-direction: column;
    justify-content: space-between;
    width: 48px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.sensor-inspector-axis-label {
    font-size: 10px;
    color: rgba(170, 162, 145, 0.85);
    -unity-text-align: middle-right;
}

.sensor-inspector-chart-host {
    flex-grow: 1;
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.18);
    border-radius: 3px;
    background-color: rgba(16, 18, 22, 0.55);
    padding: 4px 4px 4px 4px;
}

.sensor-chart {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.sensor-inspector-footer-info {
    font-size: 11px;
    color: rgba(220, 214, 198, 0.85);
    -unity-font-style: italic;
    white-space: normal;
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(170, 162, 145, 0.20);
}

/* =========================================================================
 *  Minimap — placeholder rectangle bottom-right (6c will fill it)
 * ========================================================================= */

/* =========================================================================
 *  Decision panel (sub-étape 8c.3) — right side, above sensor list
 * ========================================================================= */

/*
 * Anchored top-right, leaves room below for the sensor list. Cards are
 * spawned inside .decision-cards by DecisionPanelBinding when the
 * journal has pending recommendations.
 */
/*
 * Right-side panel — "Espace agriculteur" (sub-étape 8c.3 post-livraison
 * polish). Holds presets + free sliders (hedge removal, input intensity)
 * + horizon + recommendations cards. Spans the full vertical so all
 * farmer-controlled UI lives in one place.
 */
.decision-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;                         /* bounded by the right column so the inner ScrollView scrolls */
    padding: 10px 14px 12px 14px;
    background-color: rgba(28, 31, 36, 0.94);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    flex-direction: column;
}

.decision-panel-title {
    font-size: 14px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

/*
 * Decision popup overlay — modal, centred, dark backdrop.
 * Built on top of the existing dashboard via absolute positioning at
 * dashboard-root level. Toggled via the .hidden utility class by
 * DecisionPopupBinding.
 */
.decision-popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);          /* dim backdrop, blocks visual focus */
    align-items: center;
    justify-content: center;
}

.decision-popup-card {
    width: 460px;
    max-width: 90%;
    padding: 18px 22px 18px 22px;
    background-color: rgba(28, 31, 36, 0.98);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.40);
    flex-direction: column;
}

.decision-popup-title {
    font-size: 16px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

/*
 * Source-event sub-title — sub-étape 10a friction #2 fix.
 * Displays the causal chain « capteur → événement → recommandation »
 * just below the popup title. Ocre désaturé to feel like provenance
 * metadata rather than an instruction; smaller than the rationale so
 * it doesn't fight for attention. Hidden by default (empty text) —
 * DecisionPopupBinding sets it via RecommendationProvenance.Format.
 */
.decision-popup-source-event {
    font-size: 10px;
    color: rgba(170, 162, 145, 0.85);
    -unity-font-style: italic;
    white-space: normal;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(170, 162, 145, 0.15);
}

.decision-popup-rationale {
    font-size: 11px;
    color: rgba(220, 214, 198, 0.85);
    -unity-font-style: italic;
    white-space: normal;
    margin-bottom: 8px;
}

.decision-popup-outcomes {
    flex-direction: column;
    margin-bottom: 10px;
}

.decision-popup-prompt {
    font-size: 11px;
    color: rgba(220, 214, 198, 0.85);
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(170, 162, 145, 0.20);
}

.decision-popup-magnitude-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
}

.decision-popup-magnitude-label {
    font-size: 11px;
    color: rgba(220, 214, 198, 0.85);
}

.decision-popup-magnitude-value {
    font-size: 11px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
}

.decision-popup-magnitude-slider {
    margin-top: 4px;
    margin-bottom: 4px;
    min-height: 22px;
    flex-direction: row;
    align-items: center;
}

.decision-popup-magnitude-slider .unity-base-slider__tracker {
    background-color: rgba(16, 18, 22, 1);
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.30);
    border-radius: 3px;
}

.decision-popup-magnitude-slider .unity-base-slider__dragger {
    background-color: rgba(124, 168, 100, 1);
    border-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-radius: 4px;
    width: 14px;
    height: 14px;
}

.decision-popup-magnitude-slider .unity-base-slider__text-field {
    min-width: 60px;
    margin-left: 8px;
}

.decision-popup-magnitude-slider .unity-base-slider__text-field .unity-base-field__input {
    background-color: rgba(16, 18, 22, 1);
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.30);
    border-radius: 3px;
    padding: 2px 6px 2px 6px;
    color: rgba(238, 232, 217, 1);
    font-size: 11px;
    -unity-text-align: middle-right;
}

/*
 * Upfront capital cost line (chantier E5 / ADR #50). Mono digits so
 * the euro figure pops; same crème palette as values elsewhere. The
 * top border separates it cleanly from the slider above so it reads
 * as a derived consequence of the slider position. .hidden hides it
 * for recs whose cost is always zero (Irrigation, ReduceInputs).
 */
.decision-popup-investment {
    font-size: 11px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(170, 162, 145, 0.15);
    white-space: normal;
}

.decision-popup-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.decision-popup-button {
    margin-left: 8px;
    padding: 6px 16px 6px 16px;
    min-height: 28px;
    border-width: 1px;
    border-radius: 3px;
    font-size: 12px;
}

.decision-popup-button--ignore {
    background-color: rgba(16, 18, 22, 1);
    border-color: rgba(170, 162, 145, 0.40);
    color: rgba(220, 214, 198, 0.85);
}

.decision-popup-button--ignore:hover {
    background-color: rgba(28, 31, 36, 1);
    border-color: rgba(170, 162, 145, 0.60);
}

.decision-popup-button--validate {
    background-color: rgba(28, 38, 28, 0.95);
    border-color: rgba(124, 168, 100, 0.95);
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
}

.decision-popup-button--validate:hover {
    background-color: rgba(48, 68, 48, 1);
}

.decision-popup-button--defer {
    background-color: rgba(28, 38, 50, 0.85);
    border-color: rgba(140, 160, 190, 0.70);
    color: rgba(220, 230, 240, 0.95);
}

.decision-popup-button--defer:hover {
    background-color: rgba(40, 56, 72, 1);
}

/* =========================================================================
 *  Decision history — open button in the right panel + centred list popup
 * ========================================================================= */

.decision-history-open-button {
    margin-top: 4px;
    padding: 6px 10px 6px 10px;
    min-height: 26px;
    background-color: rgba(16, 18, 22, 1);
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.30);
    border-radius: 3px;
    color: rgba(220, 214, 198, 0.95);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.decision-history-open-button:hover {
    background-color: rgba(28, 31, 36, 1);
    border-color: rgba(170, 162, 145, 0.55);
}

/*
 * Manual action buttons inside the "Interventions ponctuelles" section.
 * Slightly more prominent than the history button (green accent) since
 * they actually mutate the model on click. Sub-étape 10a friction fix.
 */
.manual-action-button {
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 4px 10px 4px 10px;
    min-height: 24px;
    background-color: rgba(40, 64, 32, 0.95);
    border-width: 1px;
    border-color: rgba(124, 168, 100, 0.55);
    border-radius: 3px;
    color: rgba(220, 232, 200, 0.98);
    font-size: 11px;
    -unity-text-align: middle-center;
    align-self: flex-end;
}

.manual-action-button:hover {
    background-color: rgba(54, 86, 44, 1);
    border-color: rgba(124, 168, 100, 0.95);
}

.decision-history-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.60);
    align-items: center;
    justify-content: center;
}

.decision-history-card {
    width: 440px;
    max-width: 88%;
    max-height: 70%;
    padding: 18px 22px 18px 22px;
    background-color: rgba(28, 31, 36, 0.98);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.40);
    flex-direction: column;
}

.decision-history-title {
    font-size: 16px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.decision-history-help {
    font-size: 11px;
    color: rgba(220, 214, 198, 0.75);
    -unity-font-style: italic;
    white-space: normal;
    margin-bottom: 10px;
}

.decision-history-list {
    flex-direction: column;
    margin-bottom: 8px;
}

.decision-history-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 8px 6px 8px;
    margin-bottom: 4px;
    background-color: rgba(16, 18, 22, 1);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.20);
}

.decision-history-row-info {
    flex-direction: column;
    flex-grow: 1;
}

.decision-history-row-title {
    font-size: 12px;
    color: rgba(238, 232, 217, 1);
    white-space: normal;
}

/*
 * Provenance sub-line inside a history row — sub-étape 10a friction #2.
 * Smaller and lower contrast than the title so the row still reads
 * « title first, then context ». Wraps to a second line if needed.
 */
.decision-history-row-provenance {
    font-size: 10px;
    color: rgba(170, 162, 145, 0.70);
    -unity-font-style: italic;
    white-space: normal;
    margin-top: 1px;
}

.decision-history-row-button {
    margin-left: 8px;
    padding: 4px 10px 4px 10px;
    min-height: 22px;
    background-color: rgba(28, 38, 28, 0.85);
    border-width: 1px;
    border-color: rgba(124, 168, 100, 0.85);
    border-radius: 3px;
    color: rgba(238, 232, 217, 1);
    font-size: 10px;
}

.decision-history-row-button:hover {
    background-color: rgba(48, 64, 48, 1);
}

.decision-history-empty {
    font-size: 11px;
    color: rgba(170, 162, 145, 0.75);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    padding: 12px 4px 12px 4px;
}

.decision-history-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
}

.decision-history-close-button {
    padding: 6px 16px 6px 16px;
    min-height: 28px;
    background-color: rgba(16, 18, 22, 1);
    border-width: 1px;
    border-color: rgba(170, 162, 145, 0.40);
    border-radius: 3px;
    color: rgba(220, 214, 198, 0.85);
    font-size: 12px;
}

.decision-history-close-button:hover {
    background-color: rgba(28, 31, 36, 1);
    border-color: rgba(170, 162, 145, 0.60);
}

/*
 * Outcome blocks (used by the decision popup). Each block stacks a
 * horizon header + 2 metric rows (profit + biodiv) vertically so the
 * bracket text has the full popup width to breathe.
 */
.decision-outcome-block {
    flex-direction: column;
    margin-top: 6px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(170, 162, 145, 0.10);
}

.decision-outcome-horizon {
    font-size: 10px;
    color: rgba(170, 162, 145, 0.85);
    -unity-font-style: italic;
    margin-bottom: 2px;
}

.decision-outcome-metric-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 1px;
}

.decision-outcome-metric-label {
    font-size: 10px;
    color: rgba(220, 214, 198, 0.75);
    min-width: 70px;
}

.decision-outcome-metric-value {
    font-size: 10px;
    color: rgba(238, 232, 217, 0.95);
    -unity-text-align: middle-right;
    white-space: normal;
    flex-shrink: 1;
}

/* Color hints per metric type — applied on top of the base value class. */
.decision-outcome-profit {
    color: rgba(220, 214, 198, 0.95);
}

.decision-outcome-biodiv {
    color: rgba(124, 168, 100, 0.95);
}

/* =========================================================================
 *  Sensor list — floating bottom-right panel (restored after 8c.3 polish
 *  iteration: capteurs are passive observations independent from the
 *  climate/policy cadre, so they live outside scenario-panel).
 * ========================================================================= */

.sensor-list-container {
    flex-shrink: 0;
    margin-left: 10px;
    width: 240px;
    max-height: 178px;
    padding: 6px 12px 6px 12px;
    background-color: rgba(28, 31, 36, 0.94);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    flex-direction: column;
    justify-content: flex-start;
}

.sensor-list-title {
    font-size: 12px;
    color: rgba(220, 214, 198, 0.75);
    -unity-font-style: italic;
    margin-bottom: 3px;
}

.sensor-list-rows {
    flex-direction: column;
}

/*
 * One row per sensor. Created at runtime by SensorListBinding from the
 * scene's SensorMetadataTag components. The .sensor-row-status-dot
 * (online/deferred) sits at the left, with a two-line text block at
 * the right.
 */
.sensor-list-row {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.03);
    border-radius: 3px;
}

/*
 * Highlighted state — toggled via class by SensorListBinding either
 * when the row receives a PointerEnter or when the scene-side
 * SensorHoverEmitter raises an Enter for the matching sensor id.
 * Provides the UI feedback of the bidirectional hover sync (6c.3).
 */
.sensor-list-row--highlighted {
    background-color: rgba(124, 168, 100, 0.12); /* vert pâle très transparent */
}

.sensor-status-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-top: 3px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.55);
    flex-shrink: 0;
}

.sensor-status-dot--online {
    background-color: rgba(124, 168, 100, 1);    /* vert pâle, branché */
}

.sensor-row-text {
    flex-direction: column;
    flex-grow: 1;
}

.sensor-row-name {
    font-size: 12px;
    color: rgba(238, 232, 217, 1);                /* ivoire */
}

.sensor-list-legend {
    margin-top: 8px;
    flex-direction: column;
}

.sensor-list-legend-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.sensor-list-legend .sensor-status-dot {
    margin-top: 0;
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

.sensor-list-legend-text {
    font-size: 10px;
    color: rgba(220, 214, 198, 0.70);
    -unity-font-style: italic;
}

/* =========================================================================
 *  Viewport warning banner — appears under 1280 px width
 * ========================================================================= */

.viewport-warning {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 8px 16px 8px 16px;
    background-color: rgba(112, 56, 38, 0.92);  /* terre brûlée désaturée */
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.viewport-warning-text {
    font-size: 12px;
    color: rgba(238, 232, 217, 1);
    -unity-font-style: italic;
    white-space: normal;
}

/* Utility class toggled by ViewportWarningBinding. */
.hidden {
    display: none;
}
